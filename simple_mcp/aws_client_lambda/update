## **Enhanced Version for Better Package Details:**

Here's an improved version that clearly separates successful and failed packages:

```python
def _get_patch_operation_results(self, instance_id: str, operation_id: Optional[str] = None, 
                                region: str = "us-east-1") -> str:
    """Get detailed patch operation results with success/failure breakdown"""
    try:
        ssm = boto3.client('ssm', region_name=region)
        
        # Get patch history for the instance
        response = ssm.describe_instance_patch_states(
            InstanceIds=[instance_id]
        )
        
        if not response.get('InstancePatchStates'):
            return self._safe_json_response(False, error="No patch state found for instance", instance_id=instance_id)
        
        patch_state = response['InstancePatchStates'][0]
        
        # Get detailed patch results with pagination
        all_patches = []
        next_token = None
        
        while True:
            params = {
                'InstanceId': instance_id,
                'MaxResults': 100
            }
            if next_token:
                params['NextToken'] = next_token
                
            patch_response = ssm.describe_instance_patches(**params)
            all_patches.extend(patch_response.get('Patches', []))
            
            next_token = patch_response.get('NextToken')
            if not next_token:
                break
        
        # Categorize patches by state
        successful_patches = []
        failed_patches = []
        installed_pending_reboot = []
        missing_patches = []
        not_applicable = []
        
        for patch in all_patches:
            patch_info = {
                'Title': patch.get('Title', 'N/A'),
                'KBId': patch.get('KBId', 'N/A'),
                'CVEIds': patch.get('CVEIds', []),  # Security CVEs if applicable
                'Classification': patch.get('Classification', 'N/A'),
                'Severity': patch.get('Severity', 'N/A'),
                'State': patch.get('State', 'N/A'),
                'InstalledTime': patch.get('InstalledTime', '').isoformat() if patch.get('InstalledTime') else None,
                'Version': patch.get('Version', 'N/A'),  # Package version
            }
            
            state = patch.get('State', '')
            
            if state == 'INSTALLED':
                successful_patches.append(patch_info)
            elif state == 'FAILED':
                # Try to get failure reason
                patch_info['FailureReason'] = patch.get('FailureReason', 'Unknown')
                failed_patches.append(patch_info)
            elif state == 'INSTALLED_PENDING_REBOOT':
                installed_pending_reboot.append(patch_info)
            elif state == 'MISSING':
                missing_patches.append(patch_info)
            elif state == 'NOT_APPLICABLE':
                not_applicable.append(patch_info)
        
        # Get command invocation details if operation_id provided
        command_details = None
        command_output = None
        
        if operation_id:
            try:
                cmd_response = ssm.get_command_invocation(
                    CommandId=operation_id,
                    InstanceId=instance_id
                )
                
                # Parse the actual package manager output
                output = cmd_response.get('StandardOutputContent', '')
                error_output = cmd_response.get('StandardErrorContent', '')
                
                # Extract package names from output (for Linux systems)
                installed_packages = []
                failed_packages = []
                
                # Common patterns for different package managers
                if 'yum' in output.lower() or 'dnf' in output.lower():
                    # Parse yum/dnf output
                    for line in output.split('\n'):
                        if 'Installed:' in line:
                            installed_packages.append(line.strip())
                        elif 'Failed:' in line or 'Error:' in line:
                            failed_packages.append(line.strip())
                elif 'apt' in output.lower():
                    # Parse apt output
                    for line in output.split('\n'):
                        if 'Setting up' in line or 'Unpacking' in line:
                            installed_packages.append(line.strip())
                        elif 'E:' in line or 'Err:' in line:
                            failed_packages.append(line.strip())
                
                command_details = {
                    'CommandId': cmd_response['CommandId'],
                    'Status': cmd_response['Status'],
                    'StatusDetails': cmd_response.get('StatusDetails', ''),
                    'ExecutionEndTime': cmd_response.get('ExecutionEndDateTime', '').isoformat() if cmd_response.get('ExecutionEndDateTime') else None,
                    'InstalledPackages': installed_packages[:20],  # First 20 to avoid huge response
                    'FailedPackages': failed_packages,
                    'StandardOutput': output[:2000] if output else 'No output',  # First 2000 chars
                    'StandardError': error_output[:1000] if error_output else 'No errors'
                }
            except Exception as e:
                logger.warning(f"Could not get command details: {e}")
        
        # Generate summary statistics
        summary = {
            'TotalPatches': len(all_patches),
            'SuccessfullyInstalled': len(successful_patches),
            'Failed': len(failed_patches),
            'PendingReboot': len(installed_pending_reboot),
            'Missing': len(missing_patches),
            'NotApplicable': len(not_applicable),
            'SuccessRate': f"{(len(successful_patches) / len(all_patches) * 100):.1f}%" if all_patches else "0%"
        }
        
        return self._safe_json_response(
            True,
            instanceId=instance_id,
            summary=summary,
            patchState={
                'OperationStartTime': patch_state.get('OperationStartTime', '').isoformat() if patch_state.get('OperationStartTime') else 'N/A',
                'OperationEndTime': patch_state.get('OperationEndTime', '').isoformat() if patch_state.get('OperationEndTime') else 'N/A',
                'Operation': patch_state.get('Operation', 'N/A'),
                'RebootOption': patch_state.get('RebootOption', 'N/A'),
                'LastNoRebootInstallOperationTime': patch_state.get('LastNoRebootInstallOperationTime', '').isoformat() if patch_state.get('LastNoRebootInstallOperationTime') else None
            },
            successfulPatches=successful_patches[:50],  # Limit to avoid huge responses
            failedPatches=failed_patches,  # All failed patches (usually fewer)
            installedPendingReboot=installed_pending_reboot,
            missingPatches=missing_patches[:20],  # First 20 missing
            commandDetails=command_details
        )
    except Exception as e:
        return self._handle_aws_error("get_patch_operation_results", e, instance_id=instance_id)
```

## **Additional Enhancement - Get Package-Level Details:**

Add this new method for Linux package-level details:

```python
def _get_installed_packages_via_ssm(self, instance_id: str, region: str = "us-east-1") -> str:
    """Get list of installed packages directly from the system"""
    try:
        # Detect OS and run appropriate command
        commands = [
            "# Detect OS and list packages",
            "if [ -f /etc/redhat-release ]; then",
            "  echo '=== YUM/DNF PACKAGES ==='",
            "  rpm -qa --last | head -50",  # Last 50 installed packages
            "  echo '=== RECENT YUM HISTORY ==='",
            "  yum history list | head -10",
            "elif [ -f /etc/debian_version ]; then",
            "  echo '=== APT PACKAGES ==='",
            "  grep ' install ' /var/log/dpkg.log | tail -50",
            "  echo '=== RECENT APT HISTORY ==='",
            "  grep -E '(upgrade|install)' /var/log/apt/history.log | tail -20",
            "elif [ -f /etc/alpine-release ]; then",
            "  echo '=== APK PACKAGES ==='",
            "  apk list --installed | tail -50",
            "else",
            "  echo 'Unknown OS distribution'",
            "  uname -a",
            "fi"
        ]
        
        result = self._run_ssm_command(
            instance_id,
            '\\n'.join(commands),
            region,
            wait_for_completion=True,
            max_wait_time=60
        )
        
        return result
        
    except Exception as e:
        return self._handle_aws_error("get_installed_packages_via_ssm", e, instance_id=instance_id)
```

