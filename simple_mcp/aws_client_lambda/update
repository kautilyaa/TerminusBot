Add this to your Lambda to initialize patch scanning:
```python
def _initialize_patch_scanning(self, instance_ids: list, region: str = "us-east-1") -> str:
    """Initialize patch scanning for instances"""
    try:
        ssm = boto3.client('ssm', region_name=region)
        
        # Send patch scan command
        response = ssm.send_command(
            InstanceIds=instance_ids,
            DocumentName="AWS-RunPatchBaseline",
            Parameters={
                'Operation': ['Scan']
            }
        )
        
        command_id = response['Command']['CommandId']
        
        # Wait for completion
        import time
        time.sleep(10)
        
        # Get results
        patch_states = ssm.describe_instance_patch_states(
            InstanceIds=instance_ids
        )
        
        return self._safe_json_response(
            True,
            command_id=command_id,
            patch_states=patch_states
        )
    except Exception as e:
        return self._handle_aws_error("initialize_patch_scanning", e)
```

